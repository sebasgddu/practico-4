#include <iostream>
using namespace std;

int main() {
    int n, i;
    double x, pot, s;
    cout << "Ingrese x: ";
    cin >> x;
    cout << "Ingrese n: ";
    cin >> n;
    s = 0;
    pot = 1;
    for (i = 1; i <= n; i++) {
        pot = pot * x;     // x^i
        s = s + pot;
    }
    cout << "S = " << s << endl;
    return 0;
}
