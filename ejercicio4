#include <iostream>
using namespace std;

int main() {
    int n, i, s;
    cout << "Ingrese N: ";
    cin >> n;
    s = 0;
    for (i = 1; i <= n; i++) {
        if (i % 2 == 1) {
            s = s + i;   // impares suman
        } else {
            s = s - i;   // pares restan
        }
    }
    cout << "S = " << s << endl;
    return 0;
}
