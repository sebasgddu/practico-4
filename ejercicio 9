#include <iostream>
using namespace std;

int main() {
    int n, i;
    double x, pot, fac, s;
    cout << "Ingrese x: ";
    cin >> x;
    cout << "Ingrese n: ";
    cin >> n;
    s = 0;
    pot = 1;
    fac = 1;
    for (i = 1; i <= n; i++) {
        pot = pot * x;
        fac = fac * i;
        if (i % 2 == 1) {
            s = s + pot / fac;
        } else {
            s = s - pot / fac;
        }
    }
    cout << "S = " << s << endl;
    return 0;
}
