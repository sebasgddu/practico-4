#include <iostream>
using namespace std;

int main() {
    int n, i;
    long long anterior, actual, siguiente;
    cout << "Ingrese n: ";
    cin >> n;
    anterior = 1;   // F0
    actual = 1;     // F1
    for (i = 2; i <= n; i++) {
        siguiente = actual + anterior;
        anterior = actual;
        actual = siguiente;
    }
    cout << "F" << n << " = " << actual << endl;
    return 0;
}
