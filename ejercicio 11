#include <iostream>
using namespace std;

int main() {
    int a, b, r;
    cout << "Ingrese el primer numero: ";
    cin >> a;
    cout << "Ingrese el segundo numero: ";
    cin >> b;
    while (b != 0) {
        r = a % b;
        a = b;
        b = r;
    }
    cout << "MCD = " << a << endl;
    return 0;
}
