#include <iostream>
using namespace std;

int main() {
    int n, i, divisores;
    cout << "Ingrese N: ";
    cin >> n;
    divisores = 0;
    for (i = 1; i <= n; i++) {
        if (n % i == 0) {
            divisores++;
        }
    }
    if (divisores == 2) {
        cout << n << " es primo" << endl;
    } else {
        cout << n << " no es primo" << endl;
    }
    return 0;
}
